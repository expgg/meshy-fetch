{
   "manifest_version": 3,
   "name": "Meshy Fetch — Free 3D Model Exporter",
   "description": "Free, open-source downloader for Meshy 3D models with support for GLB, OBJ, and textures.",
   "version": "1.0.0",
   "author": "expgg",
   "action": {
      "default_icon": {
         "16": "assets/icons/icon16.png",
         "32": "assets/icons/icon32.png",
         "48": "assets/icons/icon48.png",
         "64": "assets/icons/icon64.png",
         "128": "assets/icons/icon128.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "src/background/index.js",
      "type": "module"
   },
   "content_scripts": [
      {
         "css": [],
         "js": [ "src/content/community-bridge.js" ],
         "matches": [ "https://www.meshy.ai/*", "https://meshy.ai/*" ],
         "run_at": "document_start"
      },
      {
         "css": [],
         "js": [ "src/content/meshy-bridge.js" ],
         "matches": [ "https://www.meshy.ai/*", "https://meshy.ai/*" ],
         "run_at": "document_start"
      }
   ],
   "icons": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "64": "assets/icons/icon64.png",
      "128": "assets/icons/icon128.png"
   },
   "host_permissions": [
      "https://www.meshy.ai/*",
      "https://meshy.ai/*",
      "https://assets.meshy.ai/*",
      "https://api.meshy.ai/*"
   ],
   "permissions": [
      "scripting",
      "storage",
      "downloads"
   ]
}
