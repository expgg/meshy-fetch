{
   "manifest_version": 3,
   "name": "Meshy Fetch — Free 3D Model Exporter",
   "description": "Free, open-source downloader for Meshy 3D models with support for GLB, OBJ, FBX, 3MF, STL, and textures.",
   "version": "1.0.0",
   "author": "expgg",
   "action": {
      "default_icon": {
         "16": "assets/icons/icon16.png",
         "32": "assets/icons/icon32.png",
         "48": "assets/icons/icon48.png",
         "64": "assets/icons/icon64.png",
         "128": "assets/icons/icon128.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "static/background/index.js"
   },
   "content_scripts": [
      {
         "css": [ "workspace-widget.css" ],
         "js": [ "workspace-widget.js" ],
         "matches": [ "https://www.meshy.ai/*", "https://meshy.ai/*" ],
         "run_at": "document_idle"
      },
      {
         "css": [],
         "js": [ "community-ui.e4f6e8b3.js" ],
         "matches": [ "https://www.meshy.ai/*", "https://meshy.ai/*" ],
         "run_at": "document_idle"
      },
      {
         "css": [],
         "js": [ "community-bridge.4738728f.js" ],
         "matches": [ "https://www.meshy.ai/*", "https://meshy.ai/*" ],
         "run_at": "document_start"
      },
      {
         "css": [],
         "js": [ "meshy-bridge.c2858880.js" ],
         "matches": [ "https://www.meshy.ai/*", "https://meshy.ai/*" ],
         "run_at": "document_start"
      }
   ],
   "icons": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "64": "assets/icons/icon64.png",
      "128": "assets/icons/icon128.png"
   },
   "host_permissions": [
      "https://www.meshy.ai/*",
      "https://meshy.ai/*",
      "https://assets.meshy.ai/*",
      "https://api.meshy.ai/*"
   ],
   "permissions": [
      "scripting",
      "storage",
      "downloads"
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "community-interceptor.2e9c3aa0.js",
            "meshy-interceptor.8904ffc7.js",
            "empty.00babefb.js"
         ],
         "matches": [ "https://www.meshy.ai/*", "https://meshy.ai/*" ]
      }
   ]
}
